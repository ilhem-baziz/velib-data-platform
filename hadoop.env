CORE_CONF_fs_defaultFS=hdfs://hdfs-namenode:9000
# Heartbeat DataNodes
HDFS_CONF_dfs_heartbeat_interval=3
HDFS_CONF_dfs_namenode_heartbeat_recheck___interval=300000

# Découpage des fichiers en blocs HDFS
HDFS_CONF_dfs_blocksize=134217728

# Sommes de contrôle HDFS
HDFS_CONF_dfs_checksum_type=CRC32C
CORE_CONF_io_bytes_per_checksum=512
HDFS_CONF_dfs_replication=2
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false